flowchart LR
  subgraph U[User and Wallet Domain]
    HO[Human Owner]
    AG[AI Agent Runtime]
    CW[didKYC Cold Wallet]
    DK[Delegated Session Key]
  end

  subgraph C[Hosted Custody Domain]
    HC[Hosted Custody HKD <= 3000]
    DT[Daily Transfer Controller HKD <= 100]
  end

  subgraph G[Payment Gateway Domain]
    APB[Agentic Payment Button]
    PS[payment_skill parser]
    VE[DID VC Verifier]
    PE[Policy Engine]
    AO[Audit Orchestrator]
  end

  subgraph L[Permissioned Ledger Domain]
    SC[Policy Smart Contract]
    BS[Hyperledger Besu]
  end

  subgraph R[RegTech and External Domain]
    EK[eKYC Issuer]
    OS[Offchain Evidence Store]
    JF[JFIU STR Workflow]
  end

  HO -- initial eKYC --> EK
  EK -- issue VC --> CW

  HO -- top up --> HC
  HC --> DT
  DT -- daily transfer --> CW

  AG -- request session key --> DK
  AG -- read button --> APB
  AG -- load skill --> PS
  AG -- submit DID VC proof --> VE
  VE -- verification result --> PE
  PE -- decision approve or reject --> AG

  AG -- signed payment tx --> SC
  SC --> BS

  BS -- settlement event --> AO
  VE -- verification log --> AO
  PE -- policy log --> AO
  AO -- hash proof --> BS
  AO -- protected refs --> OS
  PE -- suspicious alert --> JF

  classDef critical fill:#eaf2ff,stroke:#1f4b99,stroke-width:1.5px,color:#102a56;
  classDef control fill:#ecfff5,stroke:#2f855a,stroke-width:1.5px,color:#1b4332;
  classDef domain fill:#f8fbff,stroke:#9fb3c8,stroke-width:1px,color:#243b53;

  class CW,HC,BS critical;
  class VE,PE,AO,DT,DK control;